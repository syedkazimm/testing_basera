# Copy to .env for local use. Every value is optional locally.
# --- Required in production ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# PostgreSQL connection string; leave unset to use local SQLite
DATABASE_URL=postgres://user:password@host:5432/basera
# --- Optional ---
# Use SMTP instead of printing emails to the console
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
